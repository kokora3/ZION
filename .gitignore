# --------------------------------------------------
# Go build / test
# --------------------------------------------------
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test

*.out
coverage.*
*.coverprofile
profile.cov

# Local Go build/test caches
.gocache*
.gomodcache*
.npm-cache*
.docker-config*

# Repository-local build and release outputs
/build/
/dist/
/.build/
/.phase13-build/
/bin/

# Optional local-built binaries without extension
/zion-node
/zionctl


# --------------------------------------------------
# Local runtime data
# --------------------------------------------------
/data/
/zion-data/
/.zion/
/.local/
/deploy/public-host/.env
/deploy/public-host/data/
/deploy/public-host/backups/
/deploy/public-host/runtime/

# Runtime identity, signing, cache, and snapshot files. Public protocol
# fixtures use distinct filenames under testdata.
**/peer.key
**/peers.json
**/node_key.json
**/priv_validator_key.json
**/priv_validator_state.json
**/application.snapshot
**/application.snapshot.previous
**/*.import.lock

# Temporary runtime/test directories
/tmp/
/temp/
*.tmp
*.pid


# --------------------------------------------------
# Logs / profiling
# --------------------------------------------------
*.log
*.prof
*.pprof
cpu.prof
mem.prof


# --------------------------------------------------
# Environment / secrets
# --------------------------------------------------
.env
.env.*
!.env.example
!.env.sample
*.key
*.pem
*.p12
*.pfx


# --------------------------------------------------
# Go workspace
# --------------------------------------------------
go.work
go.work.sum


# --------------------------------------------------
# Editors
# --------------------------------------------------
.idea/
.vscode/
*.swp
*.swo


# --------------------------------------------------
# OS junk
# --------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
*.stackdump


# --------------------------------------------------
# Generic tool caches / coverage directories
# --------------------------------------------------
.cache/
coverage/
apps/web/node_modules/
apps/web/.next/
apps/web/playwright-report/
apps/web/test-results/
apps/web/coverage/
apps/web/.e2e/
apps/web/tsconfig.tsbuildinfo
