# Copy to .env and replace only the public location. This file contains no secrets.
ZION_IMAGE=ghcr.io/kokora3/zion-node:v0.1.0-alpha.1
ZION_DEPLOY_MODE=release
ZION_DATA_DIR=/opt/zion/data
ZION_CONFIG_DIR=/opt/zion/config
ZION_BACKUP_DIR=/opt/zion/backups
ZION_PUBLIC_HOST=bootstrap-zion.example
ZION_PUBLIC_HOST_KIND=dns4
ZION_P2P_PORT=42000
ZION_COMPOSE_PROJECT=zion-public
